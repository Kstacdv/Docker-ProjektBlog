{% extends 'base.html.twig' %}

{% block title %}Logowanie{% endblock %}

{% block body %}
    <form method="post">
        {% if error %}
            <div style="color: red; margin-bottom: 15px;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                Jesteś zalogowany jako {{ app.user.userIdentifier }},
                <a href="{{ path('app_logout') }}">Wyloguj</a>
            </div>
        {% endif %}

        <h1>Zaloguj się</h1>

        <label for="inputEmail">Email</label>
        <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" required autofocus>

        <br><br>

        <label for="inputPassword">Hasło</label>
        <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <br><br>
        <button type="submit">Zaloguj</button>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} m-3">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </form>
{% endblock %}
