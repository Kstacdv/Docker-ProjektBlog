{# templates/user/password_success.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Hasło zmienione{% endblock %}

{% block body %}
    <div style="text-align: center; margin-top: 50px;">
        <h1 style="color: #28a745;">Sukces!</h1>
        <p>Twoje hasło zostało pomyślnie zaktualizowane.</p>
        <p>Możesz się teraz zalogować, używając nowych danych.</p>

        <div style="margin-top: 30px;">
            <a href="{{ path('app_login') }}" class="btn" style="background: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
                Przejdź do logowania
            </a>
        </div>
    </div>
{% endblock %}
