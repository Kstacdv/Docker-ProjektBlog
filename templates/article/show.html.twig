{% extends 'base.html.twig' %}

{% block body %}
    <article class="full-article">
        <h1>{{ article.title }}</h1>
        <p class="meta">
            Autor: {{ article.author.email : "Anonim" }}
            Data: {{ article.dateAdded|date('Y-m-d') }}
        </p>

        <div class="tags">
            Tagi:
            {% for tag in article.tags|split(',') %}
                <a href="{{ path('blog-articles', {tag: tag|trim}) }}" class="badge">{{ tag|trim }}</a>
            {% endfor %}
        </div>

        <div class="content">
            {{ article.articleBody|nl2br }}
        </div>
    </article>

    <hr>
    <a href="{{ path('main_page') }}">Powrót do strony głównej</a>
{% endblock %}
